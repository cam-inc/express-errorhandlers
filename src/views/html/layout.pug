doctype html
html
  head
    meta(http-equiv='Content-type', content='text/html; charset=utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(href='https://fonts.googleapis.com/css?family=Source+Code+Pro' rel='stylesheet' type='text/css')
    title #{data.message} - #{data.status}
    style.
      body {
        background: #546E7A;
        margin: 5%;
        font-family: 'Source Code Pro','SF Pro Text','SF Pro Icons','Helvetica Neue','Helvetica','Arial',sans-serif;
        color: #CFD8DC;
      }
      pre {
        background: #263238;
        padding: 1%;
        overflow-x:scroll;
        line-height: 148%;
        font-size: 1.1em;
      }
      .key {
        font-size: 1.2em;
        font-weight: bold;
      }
  body
    include response.pug
